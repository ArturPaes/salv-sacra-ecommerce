    {
      "name": "2. Vitrine, Catalogo & Consultas Publicas",
      "item": [
        {
          "name": "Listar Produtos Oficiais",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Produtos carregados (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const lista = pm.response.json();",
                  "const prods = Array.isArray(lista) ? lista : (lista.data || []);",
                  "pm.expect(prods.length).to.be.above(0);",
                  "const prod = prods.find(p => Array.isArray(p.variacoes) && p.variacoes.length > 0) || prods[0];",
                  "pm.environment.set('produto_id', String(prod.id));",
                  "if (prod.variacoes && prod.variacoes[0]) {",
                  "    pm.environment.set('variacao_id', String(prod.variacoes[0].id));",
                  "}",
                  "pm.environment.set('produto_preco', String(prod.preco_base || 70));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Store-Access-Token", "value": "{{store_token}}" }
