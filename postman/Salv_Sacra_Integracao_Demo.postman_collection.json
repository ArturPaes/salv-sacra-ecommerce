{
  "info": {
    "name": "Salv Sacra - Integracao Demo (Completa e Isolada)",
    "description": "Suite completa de testes de integracao em ambiente Demo isolado (X-Demo-Session). Nao altera o banco oficial nem o visual da loja real.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Demo & Sessao Isolada",
      "item": [
        {
          "name": "Iniciar / Resetar Sessao Demo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP 200 ao iniciar Demo', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Tokens cliente e admin retornados', function () {",
                  "    pm.expect(res.tokens.cliente).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.tokens.admin).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('cliente_token', res.tokens.cliente);",
                  "pm.environment.set('admin_token', res.tokens.admin);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Demo-Session", "value": "{{demo_session}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reset\": true\n}"
            },
            "url": "{{base_url}}/demo/iniciar"
          }
        },
        {
          "name": "Consultar Status da Sessao Demo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Sessao com zero pedidos iniciais', function () {",
                  "    pm.expect(res.total_pedidos).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Demo-Session", "value": "{{demo_session}}" }
            ],
            "url": "{{base_url}}/demo/status"
          }
        }
      ]
    },
    {
      "name": "2. Catalogo & Frete",
      "item": [
        {
          "name": "Listar Produtos e Capturar Item com Estoque",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const lista = pm.response.json();",
                  "const prods = Array.isArray(lista) ? lista : (lista.data || []);",
                  "pm.test('Catalogo possui produtos', function () {",
                  "    pm.expect(prods.length).to.be.above(0);",
                  "});",
                  "let escolhido = prods.find(p => Array.isArray(p.variacoes) && p.variacoes.some(v => v.estoque > 1));",
                  "if (!escolhido) escolhido = prods.find(p => Array.isArray(p.variacoes) && p.variacoes.length > 0);",
                  "const varEscolhida = escolhido.variacoes.find(v => v.estoque > 1) || escolhido.variacoes[0];",
                  "pm.environment.set('produto_id', String(escolhido.id));",
                  "pm.environment.set('variacao_id', String(varEscolhida.id));",
                  "pm.environment.set('produto_preco', String(escolhido.preco_base || 70));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Demo-Session", "value": "{{demo_session}}" }
            ],
            "url": "{{base_url}}/produtos"
          }
        },
        {
          "name": "Calcular Frete SEDEX (Demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP 200 no calculo de frete', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Retornou opcoes de frete', function () {",
                  "    const opcoes = Array.isArray(res) ? res : (res.opcoes || []);",
                  "    pm.expect(opcoes.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Demo-Session", "value": "{{demo_session}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cep\": \"88701-000\",\n  \"subtotal\": 70,\n  \"quantidade\": 1\n}"
            },
            "url": "{{base_url}}/frete/calcular"
          }
        }
      ]
    },
